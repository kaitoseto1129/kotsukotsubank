        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 “자주 쓰는 작업에서 선택”하거나, 작업 이름: “설거지” 보상: “50”(고정 금액) 또는 “300”(시급)처럼 직접 입력할 수도 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
